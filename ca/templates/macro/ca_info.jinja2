<div class="m3-card m3-card-elevated" style="margin-bottom: 32px;">
  <h3 class="m3-card-title" style="display: flex; align-items: center; gap: 8px;">
    <span class="material-symbols-outlined" style="color: var(--md-sys-color-primary);">info</span>
    인증기관 정보
  </h3>
  
  <div class="m3-grid-details">
    <div class="m3-detail-item">
      <div class="m3-detail-label">인증기관명</div>
      <div class="m3-detail-value">{{ ca_record.catitle }}</div>
    </div>
    <div class="m3-detail-item">
      <div class="m3-detail-label">CA 타입</div>
      <div class="m3-detail-value">
        {% if ca_record.catype == 'ROOT' %}
          <span class="m3-chip m3-chip-active">Root CA</span>
        {% else %}
          <span class="m3-chip m3-chip-csr">Intermediate CA</span>
        {% endif %}
      </div>
    </div>
    <div class="m3-detail-item">
      <div class="m3-detail-label">CA 도메인</div>
      <div class="m3-detail-value"><code>{{ ca_record.common_name }}</code></div>
    </div>
    <div class="m3-detail-item">
      <div class="m3-detail-label">국가코드 / 위치</div>
      <div class="m3-detail-value">{{ ca_record.country_name }} / {{ ca_record.province_name }}</div>
    </div>
    <div class="m3-detail-item">
      <div class="m3-detail-label">조직 / 부서</div>
      <div class="m3-detail-value">{{ ca_record.organization_name }} ({{ ca_record.organizational_unit_name }})</div>
    </div>
    <div class="m3-detail-item">
      <div class="m3-detail-label">담당자 이메일</div>
      <div class="m3-detail-value">{{ ca_record.email_address }}</div>
    </div>
    <div class="m3-detail-item" style="grid-column: span 2;">
      <div class="m3-detail-label">남은 유효기간 (만료일)</div>
      <div class="m3-detail-value" style="display: flex; align-items: center; gap: 8px;">
        <span>{{ ca_record.cadays }}일</span>
        <span style="font-size: 13px; color: var(--md-sys-color-error); font-weight: 500;">
          (만료까지 {{ left_ca_days }} 남음)
        </span>
      </div>
    </div>
  </div>
</div>