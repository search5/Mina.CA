{% extends "base.html" %}

{% block js %}
    {#<script src="https://cdnjs.cloudflare.com/ajax/libs/vue/2.6.10/vue.min.js" integrity="sha256-chlNFSVx3TdcQ2Xlw7SvnbLAavAQLO0Y/LBiWX04viY=" crossorigin="anonymous"></script>#}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vue/2.6.10/vue.js" integrity="sha256-ufGElb3TnOtzl5E4c/qQnZFGP+FYEZj5kbSEdJNrw0A=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.19.0/axios.min.js" integrity="sha256-S1J4GVHHDMiirir9qsXWc8ZWw74PHHafpsHp5PXtjTs=" crossorigin="anonymous"></script>
{% endblock %}

{% block left_menu %}
    <li class="m3-drawer-item">
        <a href="/">
            <span class="material-symbols-outlined">account_balance</span>인증기관(CA) 목록
        </a>
    </li>
    <li class="m3-drawer-item">
        <a href="{{ url_for('csr_pending_list') }}">
            <span class="material-symbols-outlined">pending_actions</span>CSR 대기 목록
        </a>
    </li>
    
    <div style="border-top: 1px solid var(--md-sys-color-outline-variant); margin: 12px 16px; padding-top: 12px;"></div>
    <div style="font-size: 11px; font-weight: 700; color: var(--md-sys-color-outline); padding: 0 16px 8px 16px; letter-spacing: 0.8px; text-transform: uppercase;">CA 상세 메뉴</div>

    <li class="m3-drawer-item {{ 'active' if request.args.get('filter_type', 'CERTIFICATED') == 'CERTIFICATED' and request.endpoint == 'ca_view' else '' }}">
        <a href="{{ url_for('ca_view', catop=ca_record.catop, filter_type='CERTIFICATED') }}">
            <span class="material-symbols-outlined">verified_user</span>서명완료
        </a>
    </li>
    <li class="m3-drawer-item {{ 'active' if request.args.get('filter_type') == 'REVOKE' else '' }}">
        <a href="{{ url_for('ca_view', catop=ca_record.catop, filter_type='REVOKE') }}">
            <span class="material-symbols-outlined">cancel</span>폐기됨
        </a>
    </li>
    <li class="m3-drawer-item {{ 'active' if request.args.get('filter_type') == 'CSR' else '' }}">
        <a href="{{ url_for('ca_view', catop=ca_record.catop, filter_type='CSR') }}">
            <span class="material-symbols-outlined">pending_actions</span>대기중
        </a>
    </li>

{% endblock %}
